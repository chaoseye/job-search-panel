# ---- hh.ru ----
HH_CLIENT_ID=
HH_CLIENT_SECRET=
# Должен точно совпадать с Redirect URI приложения на dev.hh.ru/admin
HH_REDIRECT_URI=http://localhost:8000/api/auth/hh/callback
# Формат обязателен: Название/версия (реальная почта для связи).
# Заглушку you@example.com hh.ru отклоняет как blacklisted — впишите свой адрес.
HH_USER_AGENT=JobSearchPanel/1.0 (your-email@your-domain.com)
HH_HOST=hh.ru
HH_RPS=1.0
# Каким токеном открывать публичные методы (поиск, карточки вакансий, справочники): app | user.
# Проверено 2026-09-11: для нового приложения токен пользователя получает 403, токен приложения работает.
HH_PUBLIC_AUTH=app

# ---- Панель ----
APP_HOST=127.0.0.1
APP_PORT=8000
# В режиме разработки (Vite на 5173) укажите http://localhost:5173, иначе оставьте пустым
FRONTEND_URL=
# Имена хостов, на которые отвечает панель, кроме 127.0.0.1 / localhost (защита от DNS-rebinding и запросов с чужих
# сайтов). Пусто — только эта машина; через запятую — например, имя компьютера в домашней сети; * — без проверки
ALLOWED_HOSTS=
# Вход из браузера с любого компьютера по одноразовой ссылке от бота (README, «Вход из браузера»): публичный
# HTTPS-адрес панели за прокси на этой же машине, например https://panel.example.com. Пусто — выключено. Прокси ведёт
# на 127.0.0.1:PANEL_PUBLIC_PORT; ссылку присылает бот по команде /open, /logout закрывает все входы
PANEL_PUBLIC_URL=
PANEL_PUBLIC_PORT=8100
# Сколько часов браузер остаётся в панели после входа по ссылке
PANEL_SESSION_HOURS=12
LOG_LEVEL=INFO
TIMEZONE=Europe/Moscow

# ---- Сканер и отбор (этап M2) ----
SCAN_DEFAULT_INTERVAL_MIN=30
SCAN_FIRST_RUN_PERIOD_DAYS=7
SCAN_MAX_NEW_PER_RUN=150
SCAN_TICK_MIN=5
# Вакансии с внешним откликом (type=direct): auto = пропускать в режиме API, оставлять с пометкой в режиме Ассистент
DIRECT_POLICY=auto
PRESCORE_MIN_FOR_CLAUDE=35
SCORE_THRESHOLD_SUITABLE=70
SCORE_THRESHOLD_MAYBE=50

# ---- Обмен с Claude Code (этап M3) ----
BATCH_SIZE=12
BATCH_DESC_MAX_CHARS=4000
BATCH_AUTO_CREATE=true
CLAUDE_CLI_AUTORUN=false

# ---- Отклики (этап M4) ----
APPLY_MODE=auto
APPLY_AUTOPILOT=false
APPLY_MIN_SCORE_AUTOPILOT=80
APPLY_MAX_PER_DAY=30
APPLY_MAX_PER_HOUR=8
APPLY_MIN_DELAY_SEC=60
APPLY_MAX_DELAY_SEC=240
APPLY_WINDOW=09:00-21:00
APPLY_DRY_RUN=false
# Не больше N откликов одному работодателю за 7 дней (действует и в режиме «Ассистент»)
APPLY_MAX_PER_EMPLOYER_7D=2

# ---- Синхронизация (этап M5) ----
SYNC_INTERVAL_MIN=15

# ---- Telegram (этап M5) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_DAILY_SUMMARY_AT=21:00
# Сообщение о каждом входе в панель по ссылке (событие login) приходит всегда, в этом списке его указывать не нужно
TELEGRAM_EVENTS=digest,batch_ready,batch_imported,applied,invitation,discard,message,captcha,auth,limit,job_error,daily,capability,resume_bump,hot,channel_post,letter,site_vacancy,search_new,studio_reply,ws_tender
# Событие letter: оценённая вакансия с сопроводительным письмом уходит в бота отдельным сообщением, если оценка не ниже
TELEGRAM_LETTERS_MIN_SCORE=50
# Команды боту через long polling: /status /pause /resume /digest /batch, при PANEL_PUBLIC_URL — /open и /logout
# (только из вашего чата)
TELEGRAM_COMMANDS=true

# ---- Обслуживание (этап M6) ----
# Ежедневная копия data/panel.db в data/backups/ (локальное время), хранить последние N
BACKUP_AT=03:30
BACKUP_KEEP=14
# После ночной копии: рутинные записи журнала (сканы, каналы, сайты), лента событий и история запусков старше N дней
# удаляются (записи о вакансиях, неотправленные сообщения Telegram и последний запуск каждой задачи остаются); 0 — хранить всё
JOURNAL_KEEP_DAYS=90
# Студии (вкладка «Студии»): предупреждать, когда за день отмечено отправленными больше N писем; сколько карточек
# работодателей hh читать за один поиск; сколько сайтов студий проверять на контакты за один запуск
STUDIOS_DAILY_LIMIT=20
STUDIOS_HH_DETAILS_PER_RUN=150
STUDIOS_CONTACTS_PER_RUN=40
# «Поднять резюме» раз в 4 часа (POST /resumes/{id}/publish) — только если зонд подтвердил доступность метода
RESUME_AUTO_PUBLISH=false
# hh закрыл этот метод приложению (403), поэтому вместо него — напоминание в Telegram «пора поднять резюме» со ссылкой
# на страницу резюме: местное время через запятую (пусто — выключено) и дни (mon-fri, mon,wed,fri или * — ежедневно).
# hh отсчитывает 4 часа от фактического нажатия, поэтому между слотами оставлен запас 15 минут
# Пример: RESUME_BUMP_REMINDER_AT=09:00,13:15,17:30 (пусто — напоминаний нет)
RESUME_BUMP_REMINDER_AT=
RESUME_BUMP_REMINDER_DAYS=mon-fri
# Утренний дайджест «горячих» вакансий в Telegram (свежие, с малым числом откликов, оценка ≥ порога; повторно не
# присылаются): местное время, пусто — выключено. Пороги общие с блоком «Горячие» на странице «Аналитика»
HOT_DIGEST_AT=09:00
HOT_MAX_RESPONSES=50
HOT_MAX_AGE_DAYS=3
HOT_MIN_SCORE=50
# Проверка закрытых вакансий: раз в сутки в это время панель перепроверяет карточки кандидатов, которых ни один
# поиск не возвращал N дней, и убирает закрытые (архив/удалена) из кандидатов; 0 дней — выключить
FRESHNESS_CHECK_AT=04:10
FRESHNESS_STALE_DAYS=2

# ---- Письма hh.ru → журнал ответов (IMAP, только чтение) ----
# hh.ru шлёт письма «просмотрел отклик», «приглашение», «отказ», «новое сообщение»; панель читает их и пишет в
# ручной журнал. Для Gmail: включите двухэтапную проверку и создайте «пароль приложения» (myaccount.google.com →
# Безопасность → Пароли приложений); пустые host/user/password — выключено
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_FROM=hh.ru
IMAP_SYNC_MIN=10
IMAP_SINCE_DAYS=30
# По приглашению (вручную, из письма или из синхронизации) сразу заказывать у Claude подготовку к собеседованию
INTERVIEW_PREP_AUTO=true
# По сообщению работодателя из письма сразу заказывать у Claude черновик ответа
REPLY_DRAFT_AUTO=true
# После изменения критериев анкеты или набора переоценивать «ниже порога» и отфильтрованные в фоне
REPROCESS_ON_CRITERIA_CHANGE=true
# Публичные Telegram-каналы с вакансиями (страница «Каналы»): раз в N минут читать их веб-версию t.me/s/<канал>,
# новые посты — в ленту панели и ссылкой в бота (событие channel_post); 0 = только кнопкой
CHANNEL_SYNC_MIN=30
# Языки постов, которые считать вакансиями: ru, en, uk (остальные — не показываются и в бота не уходят); пусто = любые
CHANNEL_LANGUAGES=ru,en
# Сайты компаний (страница «Сайты компаний»): проверять раз в N минут (0 = только кнопкой); подходящей считается вакансия
# в одном из городов (офис/гибрид) или удалённая из любого города
SITES_SYNC_MIN=60
SITES_CITIES=Москва
# Тендеры workspace.ru (страница «Тендеры»): проверять первую страницу списка и выбранных разделов раз в N минут
# (0 = только кнопкой); сколько карточек новых тендеров читать за один раз
WS_TENDERS_SYNC_MIN=60
WS_TENDERS_DETAILS_PER_RUN=30
# Таймаут локального запуска `claude -p "/hh-batch"` (при CLAUDE_CLI_AUTORUN=true), секунды. Пакет из 12 вакансий
# с письмами занимает 15–25 минут, поэтому 1800
CLAUDE_CLI_TIMEOUT_SEC=1800
# Модель для фонового `claude -p` (флаг --model). Пусто — модель по умолчанию из настроек Claude Code (ANTHROPIC_MODEL
# в ~/.claude/settings.json); claude-opus-5-5 — актуальная Opus (нужен Claude Code 2.1.280+, `claude update`), дешевле Fable
CLAUDE_CLI_MODEL=claude-opus-5-5
# Фоновый запуск разбора: раз в N минут панель сама запускает `claude -p "/hh-batch"`, если в pending/ есть пакеты
# (0 — только по кнопке); после неудачи ждёт CLAUDE_CLI_RETRY_MIN минут, после трёх подряд — останавливается
CLAUDE_CLI_TICK_MIN=5
CLAUDE_CLI_RETRY_MIN=30
# Раз в N дней панель сама повторяет безопасный зонд hh.ru и сообщает в Telegram, если возможности изменились (0 — выключить)
PROBE_INTERVAL_DAYS=7
# Проверять импортированные и отредактированные русские письма сканером скилла humanizer-ru
HUMANIZER_CHECK=true

# ---- Редко нужные (значения по умолчанию, раскомментируйте при необходимости) ----
# DATA_DIR=./data                 # база, обмен с Claude, резервные копии
# LOGS_DIR=./logs
# DATABASE_URL=                   # по умолчанию sqlite в DATA_DIR/panel.db
# HH_API_BASE=https://api.hh.ru
# HH_OAUTH_BASE=https://hh.ru
# DICTIONARIES_TTL_DAYS=7         # кеш справочников hh.ru
# EXCHANGE_IMPORT_TICK_MIN=2      # резервный импорт результатов из done/, если наблюдатель папки не сработал
